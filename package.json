  "main": "index.js",
  "type": "module",
  "scripts": {
    "start:dev": "nodemon --env-file=.env server",
    "test": "vitest",
    "db:schema": "psql -d dopa -f server/db/schema.sql",
    "db:seed": "node --env-file=.env server/db/seed/runSeed.js",
    "db:reset": "npm run db:schema && npm run db:seed",
    "render:NUKE_DATABASE": "env-cmd -f .env cross-env-shell \"psql $EXTERNAL_DATABASE_URL -f server/db/schema.sql\""
  },

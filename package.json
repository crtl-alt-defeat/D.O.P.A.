    "supertest": "^7.2.2",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@react-oauth/google": "^0.13.5",
    "bcrypt": "^6.0.0",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "node-cron": "^4.6.0",
    "pg": "^8.22.0",
    "react-router": "^8.3.0",
    "react-router-dom": "^7.18.2",
    "uuid": "^13.0.2",
    "web-push": "^3.6.7"
